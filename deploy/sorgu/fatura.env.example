# /etc/fatura/fatura.env  (chmod 600, sahibi root)
# Panel https://sorgu.co/fat adresinde yayınlanır.

HOST=127.0.0.1
PORT=3000
BASE_PATH=/fat
COOKIE_SECURE=1

# Sabit ve uzun bir değer: openssl rand -hex 32
COOKIE_SECRET=DEGISTIR

# Ayarlar, kayıtlı GİB bilgisi (şifreli) ve bilgi fişi kayıtları
DATA_DIR=/var/lib/fatura
# Kayıtlı GİB şifresinin anahtarı; verilmezse COOKIE_SECRET kullanılır
DATA_SECRET=DEGISTIR

# İlk denemeler için GİB test portalı; canlıya geçince satırı silin.
FATURA_TEST=1

# WhatsApp ile telefon doğrulama (isteğe bağlı; deploy/wa-otp.php kurulduysa)
#WA_OTP_URL=https://sorgu.co/wa-otp.php
#WA_OTP_KEY=DEGISTIR
